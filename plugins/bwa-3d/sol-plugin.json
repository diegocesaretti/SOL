{
  "schemaVersion": 2,
  "id": "bwa-3d",
  "name": "BWA 3D",
  "version": "0.2.2",
  "description": "SOL business plugin for BWA 3D with Mercado Libre DevSite MCP plus full seller API OAuth, auto-refresh, publications, prices, orders, shipments, questions, messages, claims and guarded generic API access.",
  "runtime": "node",
  "entry": "entry.mjs",
  "args": [],
  "autoStart": true,
  "restartPolicy": "on-failure",
  "capabilities": [
    "mcp.bwa3d",
    "tool.mercadolibre",
    "business.bwa3d"
  ],
  "requires": [
    "plugin-api.v1",
    "mcp.register",
    "filesystem.plugin-data"
  ],
  "permissions": [
    "mcp.register",
    "network.internet",
    "network.local",
    "filesystem.plugin-data"
  ],
  "settings": [
    {
      "key": "api_port",
      "label": "Puerto API local",
      "type": "number",
      "env": "BWA3D_SOL_API_PORT",
      "required": false,
      "default": 8781,
      "min": 1024,
      "max": 65535
    },
    {
      "key": "mercadolibre_site",
      "label": "Sitio Mercado Libre",
      "type": "select",
      "env": "BWA3D_ML_SITE",
      "required": false,
      "default": "MLA",
      "options": [
        { "value": "MLA", "label": "Argentina (MLA)" }
      ]
    },
    {
      "key": "mercadolibre_mcp_url",
      "label": "MCP oficial de Mercado Libre",
      "type": "text",
      "env": "BWA3D_ML_MCP_URL",
      "required": false,
      "default": "https://mcp.mercadolibre.com/devsite/v1/mcp"
    },
    {
      "key": "mercadolibre_client_id",
      "label": "Mercado Libre App ID",
      "type": "text",
      "description": "Se usará para la API privada del seller. No hace falta para consultar documentación mediante el MCP oficial.",
      "env": "BWA3D_ML_CLIENT_ID",
      "required": false
    },
    {
      "key": "mercadolibre_client_secret",
      "label": "Mercado Libre Client Secret",
      "type": "secret",
      "description": "Credencial de la aplicación propia BWA 3D para operaciones privadas del seller.",
      "env": "BWA3D_ML_CLIENT_SECRET",
      "required": false
    },
    {
      "key": "mercadolibre_redirect_uri",
      "label": "Mercado Libre Redirect URI",
      "type": "text",
      "description": "Debe coincidir exactamente con la URI HTTPS registrada en DevCenter.",
      "env": "BWA3D_ML_REDIRECT_URI",
      "required": false
    },
    {
      "key": "mercadolibre_pkce",
      "label": "Usar PKCE en OAuth de Mercado Libre",
      "type": "boolean",
      "description": "Activar solo si PKCE también está habilitado en la aplicación de Mercado Libre.",
      "env": "BWA3D_ML_PKCE",
      "required": false,
      "default": false
    },
    {
      "key": "mercadolibre_allow_write",
      "label": "Permitir operaciones de escritura en Mercado Libre",
      "type": "boolean",
      "description": "Control maestro de escrituras sobre Mercado Libre. Permanece apagado por defecto; activalo sólo después de validar OAuth y lecturas. Cada acción además requiere confirmación explícita en SOL.",
      "env": "BWA3D_ML_ALLOW_WRITE",
      "required": false,
      "default": false
    },
    { "key": "pulse_enabled", "label": "Publicar eventos en SOL Pulse", "type": "boolean", "env": "BWA3D_PULSE_ENABLED", "required": false, "default": false },
    { "key": "pulse_endpoint", "label": "URL local Pulse", "type": "text", "env": "BWA3D_PULSE_ENDPOINT", "required": false, "default": "http://127.0.0.1:8794/v1/ingest" },
    { "key": "pulse_token", "label": "Token compartido de ingesta", "type": "secret", "env": "BWA3D_PULSE_TOKEN", "required": false },
    { "key": "pulse_owner_id", "label": "Integrante propietario de eventos", "type": "text", "env": "BWA3D_PULSE_OWNER_ID", "required": false },
    { "key": "pulse_poll_ms", "label": "Intervalo de monitoreo (ms)", "type": "number", "env": "BWA3D_PULSE_POLL_MS", "required": false, "default": 180000, "min": 30000, "max": 3600000 }
  ]
}
