# SOL runtime
SOL_PORT=3000
# Keep localhost-only until deployment is intentionally configured for LAN/HTTPS.
SOL_HOST=127.0.0.1
SOL_LOG_LEVEL=info
# Windows only: set false to disable the SOL health icon in the notification tray.
SOL_TRAY=true

# Sessions
SOL_SESSION_DAYS=30
# Set true only when SOL is served over HTTPS.
SOL_COOKIE_SECURE=false

# PostgreSQL
# Recommended for this SOL host: a managed PostgreSQL URL such as Neon with TLS.
# Never commit the real credential. Use `pnpm db:configure` to write it into .env.
# Local Windows PostgreSQL remains supported through `pnpm db:setup`.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Keep database connections few and short-lived so cloud PostgreSQL can scale to zero.
SOL_DB_POOL_MAX=4
SOL_DB_IDLE_TIMEOUT_MS=15000
SOL_DB_CONNECT_TIMEOUT_MS=15000

# Optional AI enrichment. SOL ingestion, Life, Knowledge already stored and MCP do not require AI.
# auto: prefer OpenAI API when configured, then fall back to Codex/ChatGPT OAuth.
# openai: use only OpenAI API. codex: use only Codex/ChatGPT OAuth.
SOL_AI_PROVIDER=auto

# OpenAI Responses API — optional. Keep the real key only in your local .env.
# Standard OPENAI_API_KEY is also accepted when SOL_OPENAI_API_KEY is empty/unset.
SOL_OPENAI_API_KEY=
SOL_OPENAI_BASE_URL=https://api.openai.com/v1
# Cheap/high-volume classification and stronger small model for consolidation/planning.
SOL_OPENAI_FAST_MODEL=gpt-5.4-nano
SOL_OPENAI_MODEL=gpt-5.4-mini
SOL_OPENAI_REQUEST_TIMEOUT_MS=45000
SOL_OPENAI_MAX_OUTPUT_TOKENS=4000

# Codex App Server — optional fallback/alternative AI provider.
SOL_CODEX_BIN=codex
# SOL_CODEX_HOME=/path/to/dedicated/codex-home
# SOL_CODEX_CWD=/path/to/empty/sol-reasoning-workspace
SOL_CODEX_REQUEST_TIMEOUT_MS=30000

# Automatic Life → Knowledge consolidation.
# If no configured AI provider is available, these passes are skipped without affecting sources or MCP.
# Default: every 6 hours, at most 2 batches of 12 source items per pass.
SOL_KNOWLEDGE_CONSOLIDATION_MS=21600000
SOL_KNOWLEDGE_BATCHES_PER_RUN=2
SOL_KNOWLEDGE_BATCH_ITEMS=12

# Google Calendar OAuth (Web application client)
# Configure the exact redirect URI below in Google Cloud OAuth credentials.
SOL_GOOGLE_CLIENT_ID=
SOL_GOOGLE_CLIENT_SECRET=
SOL_GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/v1/google/callback
# Calendar reconciliation is intentionally sparse; manual sync is also available.
SOL_CALENDAR_SYNC_MS=3600000

# Gmail Input — read-only.
# By default Gmail reuses SOL_GOOGLE_CLIENT_ID / SOL_GOOGLE_CLIENT_SECRET above.
# If you use that same Google OAuth Web client, register this exact redirect URI too.
# Set SOL_GMAIL_CLIENT_ID / SOL_GMAIL_CLIENT_SECRET only if Gmail uses a different OAuth client.
SOL_GMAIL_CLIENT_ID=
SOL_GMAIL_CLIENT_SECRET=
SOL_GMAIL_REDIRECT_URI=http://127.0.0.1:3000/v1/gmail/callback
# Gmail checks recent mail every 15 minutes by default; manual sync is available in Inputs.
SOL_GMAIL_SYNC_MS=900000

# Mercado Libre OAuth
# Mercado Libre currently requires the registered redirect URI to be HTTPS and static.
# Enable PKCE in the Mercado Libre application settings and register this exact callback.
SOL_MERCADOLIBRE_CLIENT_ID=
SOL_MERCADOLIBRE_CLIENT_SECRET=
SOL_MERCADOLIBRE_REDIRECT_URI=https://your-sol-host.example/v1/mercadolibre/callback
# Argentina authorization endpoint. Override only when using another Mercado Libre country domain.
SOL_MERCADOLIBRE_AUTH_URL=https://auth.mercadolibre.com.ar/authorization
# Until public HTTPS notifications are enabled, SOL reconciles seller state periodically.
SOL_MERCADOLIBRE_SYNC_MS=3600000

# Durable outbox is normally woken by PostgreSQL NOTIFY. This is recovery only.
SOL_OUTBOX_RECOVERY_MS=1800000
# Executive brief reconciliation uses a broad window, so it can stay sparse as well.
SOL_EXECUTIVE_POLL_MS=1800000

# Default household bootstrap values are intentionally NOT hard-coded here.
# Household/member creation is handled by the onboarding flow.
