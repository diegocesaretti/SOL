# SOL runtime
SOL_PORT=3000
# Keep localhost-only until deployment is intentionally configured for LAN/HTTPS.
SOL_HOST=127.0.0.1
SOL_LOG_LEVEL=info
# Windows only: set false to disable the SOL health icon in the notification tray.
SOL_TRAY=true

# Sessions
SOL_SESSION_DAYS=30
# Set true only when SOL is served over HTTPS.
SOL_COOKIE_SECURE=false

# PostgreSQL / Neon
# SOL Core owns identity, source metadata, source items, Knowledge and Memory.
# External services NEVER receive this credential; plugins ingest through the Plugin API.
# Never commit the real credential.
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
SOL_DB_POOL_MAX=4
SOL_DB_IDLE_TIMEOUT_MS=15000
SOL_DB_CONNECT_TIMEOUT_MS=15000

# External sources are plugin-only.
# Install WhatsApp/Nexo, Home Assistant, Google, MercadoLibre and future providers
# from SOL -> Services. Provider OAuth/API credentials belong to their plugin, not here.

# Optional AI enrichment.
SOL_AI_PROVIDER=auto
SOL_OPENAI_API_KEY=
SOL_OPENAI_BASE_URL=https://api.openai.com/v1
SOL_OPENAI_FAST_MODEL=gpt-5.4-nano
SOL_OPENAI_MODEL=gpt-5.4-mini
SOL_OPENAI_REQUEST_TIMEOUT_MS=45000
SOL_OPENAI_MAX_OUTPUT_TOKENS=4000

# Codex App Server — optional AI provider/runtime.
SOL_CODEX_BIN=codex
# SOL_CODEX_HOME=/path/to/dedicated/codex-home
# SOL_CODEX_CWD=/path/to/empty/sol-reasoning-workspace
SOL_CODEX_REQUEST_TIMEOUT_MS=30000

# Automatic Life -> Knowledge consolidation.
SOL_KNOWLEDGE_CONSOLIDATION_MS=21600000
SOL_KNOWLEDGE_BATCHES_PER_RUN=2
SOL_KNOWLEDGE_BATCH_ITEMS=12

# Durable outbox recovery.
SOL_OUTBOX_RECOVERY_MS=1800000

# Internal executive automation remains optional and does not ingest external providers.
NEXO_INTERNAL_AUTOMATION=false
SOL_EXECUTIVE_POLL_MS=1800000

# Household/member creation is handled by onboarding.
