# SOL runtime
SOL_PORT=3000
# Keep localhost-only until deployment is intentionally configured for LAN/HTTPS.
SOL_HOST=127.0.0.1
SOL_LOG_LEVEL=info

# Sessions
SOL_SESSION_DAYS=30
# Set true only when SOL is served over HTTPS.
SOL_COOKIE_SECURE=false

# PostgreSQL
POSTGRES_DB=sol
POSTGRES_USER=sol
POSTGRES_PASSWORD=sol_dev_only
DATABASE_URL=postgresql://sol:sol_dev_only@localhost:5432/sol

# Redis (reserved for jobs/cache)
REDIS_URL=redis://localhost:6379

# Codex App Server
# Executable used as: <SOL_CODEX_BIN> app-server
SOL_CODEX_BIN=codex
# Optional. Leave unset to use Codex's normal ~/.codex / OS credential store.
# SOL_CODEX_HOME=/path/to/dedicated/codex-home
# Optional working directory for the Codex process.
# SOL_CODEX_CWD=/path/to/SOL
SOL_CODEX_REQUEST_TIMEOUT_MS=30000

# Durable domain-event outbox
SOL_OUTBOX_POLL_MS=2000

# Default household bootstrap values are intentionally NOT hard-coded here.
# Household/member creation is handled by the onboarding flow.
