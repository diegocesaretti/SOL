{
  "name": "@sol/server",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "baileys": "7.0.0-rc13",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
